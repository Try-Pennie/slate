#!/usr/bin/env bash
# Pre-push guards. Two independent checks run before any push:
#
#   1. Merge-gap guard — refuses to push a follow-up commit onto a branch whose
#      PR has already merged/closed (the commit would silently strand and never
#      reach main). Override with ALLOW_MERGED_PUSH=1.
#
#   1b. Workflow settings guard. Refuses a push whose workflows reference a repo
#      variable or secret that does not exist, since GitHub substitutes the
#      empty string rather than failing. Override with
#      SKIP_WORKFLOW_SETTINGS_CHECK=1.
#
#   1c. Stale-main guard. Refuses a push from a branch carrying commits whose
#      changes are already on main by patch id (a branch built off a stale
#      origin/main ref). Override with ALLOW_STALE_MAIN=1.
#
#   2. CI parity checks: runs the same checks CI runs (tsc, lint, the unit
#      suite, the Cloudflare build) so a CI-only failure is caught here instead
#      of breaking main after merge. They run inside an isolated checkout of the
#      exact commit being pushed, NOT the working tree, so the check sees exactly
#      what CI checks out (committed files only). A forgotten-to-stage file (the
#      #489 TS2307 that was green locally, red in CI) is now caught here (#490).
#      Override with SKIP_PREPUSH_CHECKS=1.
#
#   2b. Bundle weight (#2571, #2676). Once the Cloudflare build has finished,
#      the gzipped client chunks it left in the isolated tree are weighed. The
#      pushed commit's committed record (.githooks/bundle-budget.txt) must carry
#      that weight within 1 KB, and growth past 3% AND 10 KB over the record at
#      the merge base with main refuses the push. Overrides:
#      ACCEPT_BUNDLE_GROWTH=1 (the growth is intended) and
#      SKIP_BUNDLE_BUDGET_CHECK=1 (do not weigh this push).
#
# Enabled via `git config core.hooksPath .githooks` (the package.json "prepare"
# script sets this on install). No-ops the merge guard when gh is missing.
#
# git hands this hook the refs being pushed on stdin, one per line:
#   <local ref> <local sha> <remote ref> <remote sha>
set -euo pipefail

# Capture git's stdin ref lines up front (a tty means a manual run with none).
push_refs=""
[ -t 0 ] || push_refs="$(cat)"

# parse-ok: a detached HEAD legitimately has no branch name, and every guard
# below returns early on an empty branch rather than acting on a guess.
branch="$(git symbolic-ref --short HEAD 2>/dev/null || echo '')"
root_dir="$(git rev-parse --show-toplevel)"

# --- 1. Merge-gap guard -----------------------------------------------------
#
# Asked TWICE (#4355, L1034): first, so a push onto a branch already merged does not
# cost the whole gate, and again as the LAST step before every exit that lets the push
# through. A check guarding an action must be the last step before it, and the gate
# below runs for 40 seconds or more, long enough for a pull request that was open at
# the first asking to merge, since PRs here merge within seconds of going green. The
# late asking passes `late`, so its refusal says which of the two happened (L11).
# scripts/test-prepush-merge-gap-last.ts pins the order.
merge_gap_guard() {
  [ -z "$branch" ] && return 0
  [ "$branch" = "main" ] && return 0
  [ "${ALLOW_MERGED_PUSH:-}" = "1" ] && return 0
  command -v gh >/dev/null 2>&1 || return 0

  local state
  # parse-ok: this guard fails OPEN on purpose, and that is only acceptable because
  # something else closes it. An unreadable state (no auth, gh down, no PR yet) lets
  # the push through, and .github/workflows/merge-gap.yml then fires on the same push
  # server-side and FAILS when the branch's PR is merged or closed. Since #1436 that
  # backstop no longer shares this failure mode: an unreadable PR list there is a red
  # run, not a green one. Do not "fix" this to fail closed without checking that,
  # since blocking every push made without gh auth would be worse than the gap.
  # From the repository root, because the late asking runs after the hook has moved
  # into the isolated tree it built in.
  state="$(cd "$root_dir" && gh pr view "$branch" --json state --jq .state 2>/dev/null || echo '')"
  if [ "$state" = "MERGED" ] || [ "$state" = "CLOSED" ]; then
    echo "" >&2
    echo "✋ pre-push blocked: the PR for '$branch' is already $state." >&2
    if [ "${1:-}" = "late" ]; then
      echo "   It was open when this push started, and became $state while the checks ran." >&2
    fi
    echo "   Pushing here strands the commit — it won't reach main." >&2
    echo "   Branch fresh off main instead, e.g.:" >&2
    echo "     git checkout -b <new-branch> origin/main && git cherry-pick <sha>" >&2
    echo "   Or, if intentional: ALLOW_MERGED_PUSH=1 git push ..." >&2
    echo "" >&2
    exit 1
  fi
}
merge_gap_guard

# --- 1b. Workflow settings guard (#1500) ------------------------------------
#
# A workflow can reference `${{ vars.X }}` / `${{ secrets.X }}` for a setting
# that was never created, and GitHub interpolates the EMPTY STRING rather than
# failing, so the step runs misconfigured while the file reads as configured.
# That is what took the production canary down on 2026-08-14.
#
# It runs HERE rather than in CI because listing repo variables and secret names
# needs a token with Actions variables/secrets read access, which the default
# GITHUB_TOKEN does not have and cannot be granted through the `permissions:`
# key. See the note in scripts/check-workflow-settings.ts.
#
# The decision lives in its own lib so it can be driven by
# scripts/test-workflow-settings-guard.ts without a remote. It runs just after
# the stale-main guard below, which fetches origin/main, because the list of
# changed paths it reads is a diff from the merge base with origin/main (#3898).

# --- 1c. Stale-main guard (#1612) -------------------------------------------
#
# A branch created from a stale `origin/main` ref silently carries commits that
# are already on main. Its diff against its own merge base then shows another
# change's work as this branch's, its PR conflicts, and the branch tip can carry
# a different change's commit message. That happened twice on 2026-08-29 and cost
# two thrown-away PRs (#1603, #1605), and it surfaced only at PR time as a merge
# conflict, which reads as an ordinary rebase rather than as a branch that was
# wrong from the start.
#
# AGENTS.md has stated the rule for months with nothing enforcing it. The
# decision lives in its own lib so scripts/test-stale-main-guard.ts can drive it
# with a stub git and no remote; this only supplies the branch name.
#
# Cost: one `git fetch --no-tags origin main`, a single ref, on every push.
"$root_dir/.githooks/lib/stale-main-guard.sh" "$branch" || exit 1

# The files this branch changes, for 1b above and 1d below: a diff from the
# branch's MERGE BASE with origin/main, never a two dot diff from an upstream tip,
# which after a rebase or a merge of a moved main names main's files as the
# branch's (#3898, scripts/test-prepush-changed-paths.ts).
# parse-ok: fails CLOSED, not open. A diff that cannot be read (no origin/main, a
# shallow clone) yields the literal "UNKNOWN", and the guard then RUNS the check
# rather than skipping it, because an unreadable diff and a push that touched no
# workflow would otherwise be the same empty string and the skip would be silent
# (#1436). Running it costs one GitHub round trip and can only be right.
changed_paths="$("$root_dir/.githooks/lib/push-changed-paths.sh")"
"$root_dir/.githooks/lib/workflow-settings-guard.sh" "$changed_paths" || exit 1

# --- 1d. Security-review reminder (#1043) -----------------------------------
#
# Review here is self-merge with the automated gates as the only reviewer, which is
# a deliberate trade (docs/review-process.md). Its one soft spot is judgement about
# who may do what: the gates prove the code does what it says, and cannot notice
# that what it says is too permissive.
#
# So a push touching the authorization, webhook, routing or schema surfaces prints a
# reminder. It NEVER blocks, on purpose: nothing in CI can run a review that needs a
# person, so a blocking version would be a gate whose only satisfying action is to
# set its own skip variable. It reuses the changed-path list computed above.
"$root_dir/.githooks/lib/security-review-reminder.sh" "$changed_paths"

# --- 2. CI parity checks ----------------------------------------------------
if [ "${SKIP_PREPUSH_CHECKS:-}" = "1" ]; then
  merge_gap_guard late
  exit 0
fi

root="$(git rev-parse --show-toplevel)"

# Which commit is being pushed? Prefer the local sha git handed us on stdin (the
# exact tip going to the remote); ignore branch deletions (an all-zero sha) and
# fall back to HEAD for a manual run with no stdin.
pushed_sha=""
while read -r _lref lsha _rref _rsha; do
  [ -z "$lsha" ] && continue
  case "$lsha" in *[!0]*) pushed_sha="$lsha"; break ;; esac
done <<EOF
$push_refs
EOF
[ -n "$pushed_sha" ] || pushed_sha="$(git rev-parse HEAD)"

echo "▶ pre-push: CI parity checks (tsc · lint · tests · build) against the pushed commit ${pushed_sha:0:12}, in an isolated checkout. Skip with SKIP_PREPUSH_CHECKS=1." >&2

# Run the checks against the committed tree, not the working tree, so an
# untracked/uncommitted file can't make them pass locally yet fail CI (#490).
tmp_parent="$(mktemp -d)"
tree="$tmp_parent/tree"
# The Cloudflare build runs in the background (see below), so an early exit from
# a failing check leaves it writing into a worktree about to be removed. It is
# killed as a PROCESS GROUP: `pnpm` spawns the real builder, so killing only the
# pid we hold leaves the build itself running.
build_pid=""
kill_build() {
  [ -n "${build_pid:-}" ] || return 0
  kill -TERM -- -"$build_pid" 2>/dev/null || kill -TERM "$build_pid" 2>/dev/null || true
  wait "$build_pid" 2>/dev/null || true
  build_pid=""
  echo "   (the Cloudflare build was still running and has been cancelled; fix the failure above, then push again)" >&2
}
cleanup() {
  kill_build
  git worktree remove --force "$tree" >/dev/null 2>&1 || true
  rm -rf "$tmp_parent" 2>/dev/null || true
}
trap cleanup EXIT

"$root/.githooks/lib/isolate-pushed-tree.sh" "$pushed_sha" "$tree"
cd "$tree"

# Real deps in the isolated tree: a symlinked node_modules escapes the worktree
# root and Turbopack (next build) rejects it. --prefer-offline reuses the warm
# pnpm store, so this is a few seconds and mirrors CI's clean install exactly.
pnpm install --frozen-lockfile --prefer-offline

# Stale Next.js route-type stubs make a clean tree fail tsc; clear them first.
rm -rf .next/types 2>/dev/null || true

# tsc runs ALONE, and that ordering is load bearing (#1594). `next build`
# generates .next/types, and tsconfig.json includes `.next/types/**/*.ts`, so a
# build running alongside tsc has tsc reading a directory the build is writing.
# That is the same coupling the `rm -rf .next/types` above exists for, and
# overlapping the two would reintroduce it in a nondeterministic form: a pre-push
# gate that fails at random is worse than a slow one, because the response to it
# is to re-run rather than to look.
pnpm exec tsc --noEmit

# The full Cloudflare/OpenNext build (#412): catches build-only breaks (e.g. an
# edge-incompatible import tsc accepts) before they reach main and skip the
# deploy. NEXT_PUBLIC_* mirror CI's build env (public, inlined at build time).
#
# It runs CONCURRENTLY with lint and the tests, which is safe because neither
# reads what it writes: eslint ignores `.next/**` and `.open-next/**` (see
# eslint.config.mjs), and vitest collects only `src/**/*.test.{ts,tsx}`. Its
# output goes to a log rather than interleaving with theirs, and is printed in
# full if it fails, so a failure still reads as one thing at a time.
#
# `set -m` gives it its own process group so kill_build can take down the whole
# tree rather than just the pnpm wrapper.
echo "▶ pre-push: starting the Cloudflare build in the background, alongside lint and the tests." >&2
build_log="$tmp_parent/build.log"
set -m
NEXT_PUBLIC_APP_URL=https://slate.trypennie.app \
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co \
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ci_placeholder \
NEXT_PUBLIC_GOOGLE_HOSTED_DOMAIN=trypennie.com \
  pnpm cf:build >"$build_log" 2>&1 &
build_pid=$!
set +m

pnpm lint
# Armed here because nobody edits this isolated tree, so any write into scripts/,
# src/ or worker/ during the run is a suite's (#2733). Set on this one command
# rather than exported, so nothing after it inherits the mode.
SLATE_TREE_TRIPWIRE=pre-push pnpm test

# The build's verdict. `wait` returns its exit status, and a failure prints the
# whole captured log: a build that failed silently into a file nobody reads would
# be a gate that passed while checking nothing.
echo "▶ pre-push: lint and tests done, waiting on the Cloudflare build." >&2
if ! wait "$build_pid"; then
  build_pid=""
  echo "" >&2
  echo "pre-push blocked: the Cloudflare build failed. Its full output:" >&2
  cat "$build_log" >&2
  exit 1
fi
build_pid=""

# --- 2b. Bundle weight (#2571, #2676) ---------------------------------------
#
# The client bundle is weighed HERE, against the tree that was just built, because
# the global guard (~/.claude/hooks/check-bundle-budget.sh) reads the checkout's
# build, which this gate never makes, and so reports "stale, nothing judged" on
# every Slate push.
#
# The budget is a record COMMITTED in the repo (.githooks/bundle-budget.txt), not
# the machine local file in ~/.claude/state it used to share with that guard. That
# file moved only on an explicit acceptance, so every change growing the bundle
# inside the margin left it behind and the next change was judged against a total
# main had already outgrown: on 2026-09-24 it sat 11 KB behind (#2676). It was
# also per machine, and moved by pushes of branches that never merged. So:
#
#   - the pushed commit's record must equal what that commit builds to, within a
#     1 KB noise band, or the push is refused with the command to re-record. The
#     change that moves the bundle moves the record, in the same push;
#   - growth is judged against the record committed at the MERGE BASE with main,
#     which costs a `git show` rather than a second build, and past 3% AND 10 KB
#     is refused unless ACCEPT_BUNDLE_GROWTH=1.
#
# The judge is the PUSHED tree's scripts/bundle-budget.ts, so the rule and the
# record come from the revision being judged (L398); the rule lives in
# scripts/lib/bundle-budget.ts and scripts/test-prepush-bundle-budget.ts pins it.
#
# It runs after the build's wait and so sits on the critical path, about a second
# per push (a few dozen chunks gzipped once each). That is deliberate: it needs the
# FINISHED build, so it cannot overlap the build the way lint and the tests do,
# and it must run before the EXIT trap removes $tree.
#
# Any exit but 0 fails the push. The build has just succeeded, so a tree with no
# chunks in it means the build's output moved, a defect in this gate rather than a
# property of the machine, and a printed skip would let it rot unnoticed (L98).
bundle_budget_check() {
  if [ "${SKIP_BUNDLE_BUDGET_CHECK:-}" = "1" ]; then
    echo "bundle-budget: SKIP_BUNDLE_BUDGET_CHECK=1, so this push's client bundle was not weighed and its record was not checked." >&2
    return 0
  fi

  local base_sha base_file accept out rc
  # The merge base with origin/main, which the stale main guard above has just
  # fetched. parse-ok: fails SAFE and says so. An unfindable merge base is the empty
  # string, which the judge reports as "growth against main was not judged" while
  # still holding the record to this build.
  base_sha="$(git -C "$root" merge-base "$pushed_sha" origin/main 2>/dev/null || echo '')"
  base_file="$tmp_parent/bundle-budget.base.txt"
  rm -f "$base_file"
  if [ -n "$base_sha" ]; then
    # A merge base from before the record existed has no file: the judge says so.
    git -C "$root" show "$base_sha:.githooks/bundle-budget.txt" >"$base_file" 2>/dev/null || rm -f "$base_file"
  fi
  # A flag word rather than an array: the Mac's bash 3.2 rejects an empty array
  # expansion under set -u.
  accept=""
  [ "${ACCEPT_BUNDLE_GROWTH:-}" = "1" ] && accept="--accept"

  echo "▶ pre-push: weighing the client bundle the build left in the isolated tree." >&2
  # `out="$(cmd)"; rc=$?` would die on the assignment under set -e before rc is
  # read (L612), so the status is taken from the failing branch of `||`.
  # NODE_NO_WARNINGS keeps node's notice about the .ts module type out of the verdict;
  # a crash still reaches $out through 2>&1 and is printed below.
  rc=0
  out="$(NODE_NO_WARNINGS=1 node --experimental-strip-types "$tree/scripts/bundle-budget.ts" judge --tree "$tree" \
    --base-file "$base_file" --base-sha "$base_sha" $accept 2>&1)" || rc=$?

  case "$rc" in
    0)
      [ -n "$out" ] && printf '%s\n' "$out" >&2
      return 0 ;;
    2)
      {
        echo ""
        printf '%s\n' "$out"
        echo ""
        echo "To push without judging the bundle at all this once (nothing is checked):"
        echo "    SKIP_BUNDLE_BUDGET_CHECK=1 git push ..."
        echo "BEFORE overriding you MUST explain to the user, in plain non-technical language, WHY,"
        echo "so they can judge whether it makes sense. Never override silently."
        echo ""
      } >&2
      exit 1 ;;
    *)
      {
        echo ""
        echo "pre-push blocked: the bundle budget could not judge this push (exit $rc)."
        printf '%s\n' "$out"
        echo "To push without judging the bundle at all this once: SKIP_BUNDLE_BUDGET_CHECK=1 git push ..."
        echo ""
      } >&2
      exit 1 ;;
  esac
}
bundle_budget_check

# The last step before the push (#4355): the pull request may have merged while the
# gate above ran.
merge_gap_guard late
exit 0
