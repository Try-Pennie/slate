{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "slate",
	"main": "worker/index.ts",
	// Cron triggers drive worker/index.ts scheduled(); keep in lockstep with
	// worker/cron-routes.ts (scripts/test-cron-routes.ts enforces it).
	"triggers": {
		"crons": [
			"* * * * *",
			"*/5 * * * *",
			"0 * * * *",
			"0 13 * * MON-FRI",
			"0 14 * * MON-FRI",
			"0 11 * * *",
			"0 12 * * *",
			"5 3 * * *",
			"*/15 * * * *",
			"14,44 * * * *",
			"0 */6 * * *",
			"17 4 * * *",
			"17 10 * * *",
			"23,53 * * * *",
			"13,43 * * * *",
			"41 5 * * *",
			"41 9 * * *"
		]
	},
	// The every-minute cron ran four lanes (sync/recompute/outbox/selfheal) in ONE
	// scheduled() invocation sharing its CPU budget; at scale they exceeded the
	// default 30s cron-CPU ceiling ~5% of ticks (#760). Raise it to 2 min. This IS
	// honored for a sub-hourly cron, despite the frequency-gated docs table. Since
	// #3693 each lane runs as its own placed request over the SELF binding below,
	// under this same limit, and only a lane that falls back to in process still
	// shares the cron invocation's.
	// Billed on actual CPU used, not the ceiling, so a high limit is free.
	// Evidence and current headroom: docs/cloudflare-platform-notes.md.
	//
	// The same limit also applies to web requests, and that is DECIDED, not missed
	// (Dan, 2026-10-03, #3107): billing is for CPU used, not the limit, so a high
	// ceiling costs nothing by itself; the crons peak around 45s and need the room;
	// web requests peak around 5s (CPU p99 4,908ms, 2026-09-14). A lower request
	// limit would mean splitting the crons into a separate Worker, which was
	// declined. Keep ONE limit here unless that decision is revisited.
	"limits": { "cpu_ms": 120000 },
	"account_id": "3e7f907a9c19e51417873e2cce4fbc5c",
	"routes": [
		{
			"pattern": "slate.trypennie.app",
			"custom_domain": true
		}
	],
	// #1052: production answers on the custom domain ONLY. workers.dev was a second
	// live origin serving the same code and the same bindings (so the same database
	// and the same Google credentials), outside the trypennie.app zone and outside
	// anything zone level, and it confused every NEXT_PUBLIC_APP_URL relative flow:
	// an OAuth redirect, an embed, a manage link.
	//
	// `preview_urls` is set EXPLICITLY and that is the part worth knowing. Wrangler
	// defaults it to whatever `workers_dev` is, so leaving it out would have turned
	// off `wrangler versions upload` previews as a side effect of this line, and
	// would silently turn them back on for anybody who ever re-enables workers.dev.
	// Off is the right answer for both here: a preview URL serves a real version with
	// production bindings on a public address, which is the same exposure this line
	// closes, and a preview emits no observability events anyway (see AGENTS.md), so
	// it is a weak debugging tool. To use one deliberately, set `preview_urls` true,
	// upload, and set it back.
	"workers_dev": false,
	"preview_urls": false,
	"compatibility_date": "2025-08-01",
	// nodejs_compat is required for OpenNext + googleapis/node:crypto.
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Non-secret runtime config lives here so deploys can't wipe it (Wrangler
	// treats the config as the source of truth for plain vars; dashboard-only
	// vars get overwritten on deploy). Only CALCOM_API_KEY is sensitive enough to
	// stay a secret; the org id + base url are not secret, so they live here too.
	"vars": {
		// Google Workspace sign-in gate (#589). Enforced server-side in the auth
		// callback; the NEXT_PUBLIC_ twin only drives the `hd` login hint. Kept here
		// (not dashboard-only) so the security control survives every deploy — a
		// dashboard plain var gets wiped on the next `wrangler deploy`.
		"GOOGLE_HOSTED_DOMAIN": "trypennie.com",
		"NEXT_PUBLIC_GOOGLE_HOSTED_DOMAIN": "trypennie.com",
		// The two launch flags. Flipping either costs a DEPLOY (about two minutes),
		// which is accepted rather than overlooked (#1052): both govern a cutover
		// step somebody decides on purpose, not an incident somebody reacts to, so
		// neither wants an instant switch. What that costs is that there is no kill
		// switch here: if a flag ever gates something that has to be turnable off in
		// seconds under load, back it with a monitor_settings row (the pattern the
		// alert cooldowns already use, read per tick from the database) rather than
		// adding a var. DEPLOY.md's "Feature flags and the kill switch" section
		// carries the decision and what would change it.
		"OOO_CALCOM_DUAL_WRITE": "true",
		// Committed on 2026-10-02 (Dan, the Slate launch day), so managers and admins
		// reach the console during the pilot. scripts/test-console-open.ts pins it.
		"AGENT_SCHEDULING_LIVE": "true",
		"CALCOM_BASE_URL": "https://api.cal.com/v2",
		"CALCOM_ORG_ID": "19474",
		// Daily 7am ET OOO-approvals email (port of the Pipedream flow). Empty TO
		// = the digest no-ops. Sent from ooo@trypennie.com; replies go to systems.
		"OOO_APPROVALS_TO": "salesmanagers@trypennie.com",
		"OOO_APPROVALS_BCC": "dwright@trypennie.com",
		"OOO_APPROVALS_REPLY_TO": "systemsteam@trypennie.com",
		// The websites allowed to open the public test bucket (#2666), exact
		// origins, comma separated. Committed here and never set after a deploy,
		// so widening it is a reviewed change. Deliberately no localhost: that
		// would approve every developer machine. Empty turns the test path off.
		// The paired secret is EMBED_TEST_PASS_SECRET (wrangler secret put).
		"EMBED_TEST_ORIGINS": "https://dev.trypennie.com,https://trypennie.com",
		// The program lead token (#4389) is signed with the secret
		// PROGRAM_LEAD_TOKEN_SECRET (wrangler secret put), and has no var here.
		// Snowflake archival mirror (milestone #15). Non-secret connection config;
		// the paired secret is SNOWFLAKE_PRIVATE_KEY (wrangler secret put). The
		// export lane is a safe no-op until the private key is set, so an empty
		// account here ships harmlessly. SNOWFLAKE_ACCOUNT is the account URL
		// prefix: the part before .snowflakecomputing.com. Slate's is the
		// orgname-accountname form below, NOT the locator-plus-region form this
		// comment used to give as an example (#1200). docs/snowflake-setup.md
		// step 4 derives it. The rest match docs/snowflake-setup.sql.
		"SNOWFLAKE_ACCOUNT": "vrkfjso-rwc54963",
		"SNOWFLAKE_USER": "SLATE_SERVICE",
		"SNOWFLAKE_DATABASE": "SLATE",
		"SNOWFLAKE_SCHEMA": "PUBLIC",
		"SNOWFLAKE_WAREHOUSE": "SLATE_WH",
		"SNOWFLAKE_ROLE": "SLATE_ROLE",
		// The Google Workspace account the advisor photo refresh reads the directory
		// as (#3027). It must hold an admin role: as an agent, photos.get answers 403.
		// Dan's own account for now (his decision, 2026-10-02); it moves to a non
		// human admin mailbox at rollout, so a staff change cannot stop the photos.
		"DIRECTORY_ADMIN_SUBJECT": "dwright@trypennie.com",
		// The shared confirm line's answer in an isolate that has not yet read the stored
		// switch, booking_settings.shared_confirm_line (#3325). The switch itself is
		// flipped on the admin Hours page with no deploy; this only covers a cold isolate
		// whose read failed. "on" since #3339: the burst passed on the shared line in
		// three load runs, so a cold isolate that cannot read the switch takes the
		// shared line rather than its own. The stored switch still decides for every
		// isolate that has read it. Exactly "on" or "off": anything else is read as
		// off and logged. env.loadtest sets "on" too (vars do not inherit), and
		// scripts/test-wrangler-loadtest-env.ts pins both resolved values.
		"SHARED_CONFIRM_LINE_DEFAULT": "on"
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets",
		// #1203 / #1204: a matching request is routed to THIS Worker before the
		// asset binding answers it. Without this, Cloudflare serves anything under
		// public/ without invoking the Worker at all, so `widget.js` (the script
		// partner pages load to embed the booker) was served over plain http with
		// none of the hardening headers every page and API route carries: the
		// #1024 redirect in worker/index.ts never ran, and neither did Next's
		// global headers(), which the routing layer applies to a worker-served
		// asset.
		//
		// Scoped to the ten files we actually ship in public/ rather than `true`:
		// worker-first on `/_next/*` would spend a Worker invocation on every
		// hashed, immutable build asset, which is always a subresource of an https
		// page we already redirect. scripts/test-asset-worker-first.ts pins both
		// halves (every public/ file covered, /_next/ still excluded).
		"run_worker_first": ["/widget.js", "/embed-example.html", "/brand/*"]
	},
	// Run the Worker near the data, since this app is DB-bound (#3693). An explicit
	// Placement Hint naming the database's cloud region: Supabase reports the project
	// in `us-west-2` (West US, Oregon), and Cloudflare runs a hinted Worker "in the data
	// center with the lowest latency to your specified cloud region". Smart Placement
	// was the setting until October 2026 and never moved the cron lanes near the
	// database (they ran at Mumbai, then Amsterdam and Stockholm), because it only
	// moves a request when it judges a location "significantly faster". A hint moves
	// every fetch, the lanes sent over SELF below and the lead requests alike.
	// Cloudflare's docs list `mode`, `region`, `host` and `hostname` as mutually
	// exclusive; wrangler's own schema also accepts `"mode": "targeted"` beside a
	// region, which is this same hint spelled out, and the test accepts both forms.
	// scripts/test-worker-placement.ts pins this region in both environments.
	"placement": {
		"region": "aws:us-west-2"
	},
	"observability": {
		"enabled": true
	},
	// #3105: Cloudflare keeps the logs above for 7 days. The tail worker named here
	// (worker/log-tail/index.ts, its own config wrangler.log-tail.jsonc) is invoked
	// after every Slate invocation, redacts what it was handed and ships it to Better
	// Stack, whose retention is the plan's. It runs AFTER Slate's invocation and in
	// its own, so nothing it does can slow or fail a request.
	//
	// That Worker must EXIST before a deploy of this file, because a merge to main
	// deploys it: DEPLOY.md ("Log shipping to Better Stack") has the order. Not
	// inherited by env.loadtest (wrangler treats tail_consumers as not inheritable),
	// so the load test's synthetic traffic never reaches Better Stack.
	// scripts/test-log-tail-config.ts pins all of that against the resolved config.
	"tail_consumers": [{ "service": "slate-log-tail" }],
	// Edge rate limiter for /api/availability (#56): 30 requests/min per IP, per
	// datacenter, no DB round-trip. namespace_id is an arbitrary unique id (not a
	// created resource). period must be 10 or 60.
	"ratelimits": [
		{
			"name": "AVAIL_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 30, "period": 60 }
		},
		// Edge per-minute throttle for the public /booking confirm (#237): 3
		// requests/min per IP, per datacenter, no DB round-trip, so it no longer
		// adds latency to the lead's Confirm tap. The strict hourly cap (10/hour)
		// stays in the DB (the native binding can't express a 1-hour window).
		{
			"name": "BOOKING_RATE_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 3, "period": 60 }
		},
		// Edge per-minute burst window for the routing-preview lookup (#961): 20
		// requests/min per IP. The hourly cap (200/hour) stays in the DB.
		{
			"name": "ROUTING_RATE_LIMITER",
			"namespace_id": "1003",
			"simple": { "limit": 20, "period": 60 }
		},
		// Edge per-minute windows for the direct booking API (#961). Three separate
		// bindings because the native limiter fixes one limit per binding and these
		// are intentionally different sizes and keys; every hourly ceiling stays in
		// the DB. Write path, keyed per API key: 120/min.
		{
			"name": "BOOKINGAPI_RATE_LIMITER",
			"namespace_id": "1004",
			"simple": { "limit": 120, "period": 60 }
		},
		// Per-IP write backstop (#597), keyed per IP: 60/min. A block here is itself
		// a signal (the ceiling is too tight or a key leaked), alerted in code.
		{
			"name": "BOOKINGAPI_IP_RATE_LIMITER",
			"namespace_id": "1005",
			"simple": { "limit": 60, "period": 60 }
		},
		// Read path (lookup/list, #393), keyed per API key: 600/min, ~5x the write
		// window so status polling never starves the booking path.
		{
			"name": "BOOKINGAPI_READ_RATE_LIMITER",
			"namespace_id": "1006",
			"simple": { "limit": 600, "period": 60 }
		},
		// The customer's own manage link (#1046), keyed per IP: 20/min across cancel,
		// reschedule and the phone edit. Far above any real customer (moving one
		// appointment is a handful of requests); it exists so a garbage manage token
		// cannot buy unthrottled unauthenticated database round trips. Edge only, with
		// no hourly cap behind it, since the round trip is the thing being bounded.
		{
			"name": "MANAGE_RATE_LIMITER",
			"namespace_id": "1007",
			"simple": { "limit": 20, "period": 60 }
		}
	],
	// The second ceiling behind EVERY limiter above (#1536 for availability, #1556
	// for the rest). Each of those is enforced PER DATACENTER and counted
	// approximately, which bounds a sequential hammer and does not bound a
	// concurrent burst: measured against production on 2026-08-17, 45 sequential
	// requests were blocked at exactly 30 while 60 fired in parallel into one
	// datacenter were blocked zero times. A Durable Object is the only primitive
	// here that holds ONE count for a caller across isolates, so it is the
	// backstop behind the fast in-datacenter check rather than a replacement for
	// it. It is asked only about callers that have already crossed the escalation
	// threshold, so an ordinary booker load never reaches it.
	//
	// ONE namespace serves all six: the object id is derived from a key carrying
	// the endpoint as well as the caller, so no two endpoints share a count. Each
	// endpoint's own ceiling lives beside its sustained limit in EDGE_LIMITERS
	// (src/lib/rate-limit-core.ts) and is a large multiple of it, never equal:
	// a large office behind one NAT address is a real lead source, and this is a
	// flood backstop, not a tightening.
	"durable_objects": {
		"bindings": [
			// #3555: served by its own small Worker (wrangler.burst-limiter.jsonc), deployed
			// before this one, so waking a counter does not load the whole app. (Every Slate
			// deploy still redeploys it, which restarts the counters, #3561.) The class stays exported and its
			// migration kept here ON PURPOSE (#4025, Dan 2026-10-23): deleting a class ends rollback
			// to every version from before 2026-10-09, so it stays as rollback insurance. Revisit
			// on 2027-01-23.
			{
				"name": "BURST_LIMITER",
				"class_name": "BurstLimiter",
				"script_name": "slate-burst-limiter"
			},
			// #3325: the confirm line shared across isolates, one object per line group
			// (src/lib/booking/confirm-line-object.ts). #3500: served by its own small
			// Worker (wrangler.confirm-line.jsonc), deployed before this one, so waking an
			// idle line does not load the whole app. The class is still exported and its
			// migration kept here ON PURPOSE, as rollback insurance, like BurstLimiter's above
			// (#4025). Revisit on 2027-01-23.
			{
				"name": "CONFIRM_LINE",
				"class_name": "ConfirmLine",
				"script_name": "slate-confirm-line"
			},
			// #3512: the shared Google token holder (src/lib/google/token-holder-object.ts),
			// one object every isolate asks for an advisor's calendar token before minting
			// one. Served by its own small Worker (wrangler.token-holder.jsonc), deployed before
			// this one. The class was never Slate's, so Slate declares no migration for it and
			// this binding ships through the gradual deploy (#3352 refuses only a migration).
			{
				"name": "TOKEN_HOLDER",
				"class_name": "TokenHolder",
				"script_name": "slate-token-holder"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["BurstLimiter"]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["ConfirmLine"]
		}
	],
	// #3693: the Worker's binding to ITSELF. Placement above moves only a fetch handler,
	// never scheduled(), so worker/index.ts sends each cron lane through this binding to
	// its own default fetch handler, where the region hint runs it near the database
	// instead of wherever Cloudflare ran the cron (Mumbai and Amsterdam in October 2026).
	// No entrypoint, on purpose: placement does not apply to a named entrypoint. Without
	// this binding every lane runs in process as before, and says so in the lane timings.
	// Not inherited by env.loadtest, which binds its own Worker below.
	"services": [{ "binding": "SELF", "service": "slate" }],
	// --- the load test environment (#2242) ----------------------------------
	//
	// A SECOND Worker for the booking path scale run (#2243, #2244): ten times the
	// measured peak against a throwaway Supabase branch. It exists because there is
	// no staging environment (ADR 0007) and a run of this shape cannot be pointed at
	// production.
	//
	// Everything here is written out rather than left to inherit, and the split
	// between the two kinds of key is the thing to understand before editing it,
	// because it is silent in both directions:
	//
	//   `routes`, `triggers`, `workers_dev`, `preview_urls` and `limits` INHERIT. So
	//   omitting `routes` does not mean "no route": it means this environment claims
	//   `slate.trypennie.app`, and wrangler says so in its own words ("Deploying this
	//   environment will reassign these custom domains away from the top-level
	//   Worker"). `routes: []` is what actually detaches it, and `workers_dev: true`
	//   is what then gives it an address at all, since the top level turned that off
	//   in #1052. `preview_urls` stays false for the same reason it does up there.
	//   The crons are inherited ON PURPOSE: the run measures recompute freshness and
	//   the outbox drain UNDER the booking load, so those lanes have to be live.
	//
	//   `vars`, `ratelimits` and `durable_objects` DO NOT inherit, and an environment
	//   that omits them resolves them EMPTY. That is not a smaller configuration, it
	//   is a broken one: a missing limiter binding fails OPEN in `rate-limit.ts`
	//   (`nativeWithinLimit` alerts and returns true), so the run would measure a
	//   deployment with no ceilings while the judge attributed its 429s to ceilings
	//   that were never there.
	//
	// The namespace ids are 2001 to 2007 rather than the production 1001 to 1007
	// because a namespace id is ACCOUNT scoped: reusing one would have the load
	// run's writes (the load bar's rate, #3124) counting against the ceiling real leads are
	// judged by. `scripts/test-wrangler-loadtest-env.ts` resolves this env through
	// wrangler's own `unstable_readConfig` and asserts the RESOLVED result, so the
	// inheritance rules above are measured rather than believed.
	//
	// The database address is NOT here. `NEXT_PUBLIC_SUPABASE_URL`, the publishable
	// key and `NEXT_PUBLIC_APP_URL` are inlined at BUILD time (`src/lib/env.ts`), so
	// they go into the build environment of the deploy that produces this Worker,
	// and they also namespace the L1 caches (`slot-cache.ts`, `eligible-cache.ts`
	// key on `appUrl()`). A committed var naming a branch would be a lie the day
	// after the branch was thrown away; `scripts/loadtest/RUNBOOK.md` carries the
	// build command instead.
	"env": {
		"loadtest": {
			"routes": [],
			// Explicitly none (#3105): the load run's synthetic traffic must not reach
			// Better Stack. Empty rather than omitted, so wrangler does not warn on
			// every deploy that the top level consumer was not inherited.
			"tail_consumers": [],
			"workers_dev": true,
			"preview_urls": false,
			"vars": {
				"GOOGLE_HOSTED_DOMAIN": "trypennie.com",
				"NEXT_PUBLIC_GOOGLE_HOSTED_DOMAIN": "trypennie.com",
				"OOO_CALCOM_DUAL_WRITE": "true",
				// Follows production on purpose: test-wrangler-loadtest-env.ts requires
				// the load run to exercise production's configuration.
				"AGENT_SCHEDULING_LIVE": "true",
				"CALCOM_BASE_URL": "https://api.cal.com/v2",
				"CALCOM_ORG_ID": "19474",
				"OOO_APPROVALS_TO": "salesmanagers@trypennie.com",
				"OOO_APPROVALS_BCC": "dwright@trypennie.com",
				"OOO_APPROVALS_REPLY_TO": "systemsteam@trypennie.com",
				// The same list as production (#2666). Inert here: the load test
				// Worker holds no EMBED_TEST_PASS_SECRET, so the test path is off.
				"EMBED_TEST_ORIGINS": "https://dev.trypennie.com,https://trypennie.com",
				"SNOWFLAKE_ACCOUNT": "vrkfjso-rwc54963",
				"SNOWFLAKE_USER": "SLATE_SERVICE",
				"SNOWFLAKE_DATABASE": "SLATE",
				"SNOWFLAKE_SCHEMA": "PUBLIC",
				"SNOWFLAKE_WAREHOUSE": "SLATE_WH",
				"SNOWFLAKE_ROLE": "SLATE_ROLE",
				// Follows production (#3027); the advisor-photos lane is held back below.
				"DIRECTORY_ADMIN_SUBJECT": "dwright@trypennie.com",
				// Held to "on" whatever production says (#3325): the load run exists to measure
				// the shared confirm line, so a cold isolate here must never read the line as
				// off. Production is "on" too since #3339, so today the two agree. The seed
				// also writes the stored switch on, and the preflight refuses a branch where
				// it is not.
				"SHARED_CONFIRM_LINE_DEFAULT": "on",
				// The flag every load test stub and refusal keys on. It exists HERE and
				// nowhere else, which is the whole safety story: the Google stub, the
				// webhook short circuit, the seen-address echo and the two refusals in
				// `src/lib/loadtest-guard.ts` are all inert without it.
				"SLATE_LOADTEST": "true",
				// The lanes this deployment must not run, honoured in `worker/index.ts`
				// (`worker/lanes-disabled.ts`). Every one of them reaches a system the
				// isolated branch does not have and `SLATE_LOADTEST` does not stub:
				// `agents` reads Salesforce and rewrites the roster the seed just built,
				// `bulk-reassign` makes real Google reassignments, `monitor`,
				// `erasure-audit` and `snowflake-reconcile` page Slack about a synthetic
				// org, `busy-minutes` reads cal.com and pages Slack about the branch's
				// synthetic bookings (#3124, and it also stands down on `isLoadtest()`),
				// `ooo-digest` and `ooo-approvals` send real email to real managers,
				// `snowflake-export` writes the warehouse, and the two PII prunes redact
				// against a mirror that is not there. The kept lanes are the ones the run
				// is measuring; the full table is in `scripts/loadtest/RUNBOOK.md`.
				"SLATE_LANES_DISABLED": "advisor-photos,agents,bulk-reassign,busy-minutes,erasure-audit,monitor,ooo-approvals,ooo-digest,prune-bookings-pii,prune-warehouse-pii,snowflake-export,snowflake-reconcile"
			},
			"ratelimits": [
				{
					"name": "AVAIL_RATE_LIMITER",
					"namespace_id": "2001",
					"simple": { "limit": 30, "period": 60 }
				},
				{
					"name": "BOOKING_RATE_LIMITER",
					"namespace_id": "2002",
					"simple": { "limit": 3, "period": 60 }
				},
				{
					"name": "ROUTING_RATE_LIMITER",
					"namespace_id": "2003",
					"simple": { "limit": 20, "period": 60 }
				},
				{
					"name": "BOOKINGAPI_RATE_LIMITER",
					"namespace_id": "2004",
					"simple": { "limit": 120, "period": 60 }
				},
				{
					"name": "BOOKINGAPI_IP_RATE_LIMITER",
					"namespace_id": "2005",
					"simple": { "limit": 60, "period": 60 }
				},
				{
					"name": "BOOKINGAPI_READ_RATE_LIMITER",
					"namespace_id": "2006",
					"simple": { "limit": 600, "period": 60 }
				},
				{
					"name": "MANAGE_RATE_LIMITER",
					"namespace_id": "2007",
					"simple": { "limit": 20, "period": 60 }
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "BURST_LIMITER",
						"class_name": "BurstLimiter",
						"script_name": "slate-burst-limiter-loadtest"
					},
					{
						"name": "CONFIRM_LINE",
						"class_name": "ConfirmLine",
						"script_name": "slate-confirm-line-loadtest"
					},
					{
						"name": "TOKEN_HOLDER",
						"class_name": "TokenHolder",
						"script_name": "slate-token-holder-loadtest"
					}
				]
			},
			"migrations": [
				{
					"tag": "v1",
					"new_sqlite_classes": ["BurstLimiter"]
				},
				{
					"tag": "v2",
					"new_sqlite_classes": ["ConfirmLine"]
				}
			],
			// #3693: the load test Worker's binding to ITSELF, never to production's
			// `slate`, which would run the load run's lanes on production.
			"services": [{ "binding": "SELF", "service": "slate-loadtest" }],
			// #3693: the same hint as production, written out although `placement`
			// inherits (measured through unstable_readConfig), so the load run
			// measures the placement production runs with and a later top level edit
			// cannot move it silently. The throwaway branch must be in the same
			// region for that to mean anything: Supabase's create branch API takes
			// an optional `region`, so create it in us-west-2 (RUNBOOK step 1).
			"placement": {
				"region": "aws:us-west-2"
			}
		}
	}
}
