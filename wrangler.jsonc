{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slate",
  "main": ".open-next/worker.js",
  "account_id": "3e7f907a9c19e51417873e2cce4fbc5c",
  "routes": [{ "pattern": "slate.trypennie.dev", "custom_domain": true }],
  "workers_dev": true,
  "compatibility_date": "2025-08-01",
  // nodejs_compat is required for OpenNext + googleapis/node:crypto.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  // Run the Worker near the data (Supabase us-west) since this app is DB-bound.
  "placement": { "mode": "smart" },
  "observability": { "enabled": true }
}
