{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "slate",
	"main": "worker/index.ts",
	// Cron triggers drive worker/index.ts scheduled(); keep in lockstep with
	// worker/cron-routes.ts (scripts/test-cron-routes.ts enforces it).
	"triggers": {
		"crons": [
			"* * * * *",
			"*/5 * * * *",
			"0 * * * *",
			"0 13 * * 1-5",
			"0 14 * * 1-5",
			"0 11 * * *",
			"0 12 * * *",
			"5 3 * * *",
			"*/15 * * * *",
			"*/10 * * * *",
			"0 */6 * * *"
		]
	},
	// The every-minute cron runs four lanes (sync/recompute/outbox/selfheal) in ONE
	// scheduled() invocation sharing its CPU budget; at scale they exceeded the
	// default 30s cron-CPU ceiling ~5% of ticks (#760). Raise it to 2 min. This IS
	// honored for a sub-hourly cron, despite the frequency-gated docs table.
	// Billed on actual CPU used, not the ceiling, so a high limit is free.
	// Evidence and current headroom: docs/cloudflare-platform-notes.md.
	"limits": { "cpu_ms": 120000 },
	"account_id": "3e7f907a9c19e51417873e2cce4fbc5c",
	"routes": [
		{
			"pattern": "slate.trypennie.app",
			"custom_domain": true
		}
	],
	// #1052: production answers on the custom domain ONLY. workers.dev was a second
	// live origin serving the same code and the same bindings (so the same database
	// and the same Google credentials), outside the trypennie.app zone and outside
	// anything zone level, and it confused every NEXT_PUBLIC_APP_URL relative flow:
	// an OAuth redirect, an embed, a manage link.
	//
	// `preview_urls` is set EXPLICITLY and that is the part worth knowing. Wrangler
	// defaults it to whatever `workers_dev` is, so leaving it out would have turned
	// off `wrangler versions upload` previews as a side effect of this line, and
	// would silently turn them back on for anybody who ever re-enables workers.dev.
	// Off is the right answer for both here: a preview URL serves a real version with
	// production bindings on a public address, which is the same exposure this line
	// closes, and a preview emits no observability events anyway (see AGENTS.md), so
	// it is a weak debugging tool. To use one deliberately, set `preview_urls` true,
	// upload, and set it back.
	"workers_dev": false,
	"preview_urls": false,
	"compatibility_date": "2025-08-01",
	// nodejs_compat is required for OpenNext + googleapis/node:crypto.
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Non-secret runtime config lives here so deploys can't wipe it (Wrangler
	// treats the config as the source of truth for plain vars; dashboard-only
	// vars get overwritten on deploy). Only CALCOM_API_KEY is sensitive enough to
	// stay a secret; the org id + base url are not secret, so they live here too.
	"vars": {
		// Google Workspace sign-in gate (#589). Enforced server-side in the auth
		// callback; the NEXT_PUBLIC_ twin only drives the `hd` login hint. Kept here
		// (not dashboard-only) so the security control survives every deploy — a
		// dashboard plain var gets wiped on the next `wrangler deploy`.
		"GOOGLE_HOSTED_DOMAIN": "trypennie.com",
		"NEXT_PUBLIC_GOOGLE_HOSTED_DOMAIN": "trypennie.com",
		// The two launch flags. Flipping either costs a DEPLOY (about two minutes),
		// which is accepted rather than overlooked (#1052): both govern a cutover
		// step somebody decides on purpose, not an incident somebody reacts to, so
		// neither wants an instant switch. What that costs is that there is no kill
		// switch here: if a flag ever gates something that has to be turnable off in
		// seconds under load, back it with a monitor_settings row (the pattern the
		// alert cooldowns already use, read per tick from the database) rather than
		// adding a var. DEPLOY.md's "Feature flags and the kill switch" section
		// carries the decision and what would change it.
		"OOO_CALCOM_DUAL_WRITE": "true",
		"AGENT_SCHEDULING_LIVE": "false",
		"CALCOM_BASE_URL": "https://api.cal.com/v2",
		"CALCOM_ORG_ID": "19474",
		// Daily 7am ET OOO-approvals email (port of the Pipedream flow). Empty TO
		// = the digest no-ops. Sent from ooo@trypennie.com; replies go to systems.
		"OOO_APPROVALS_TO": "salesmanagers@trypennie.com",
		"OOO_APPROVALS_BCC": "dwright@trypennie.com",
		"OOO_APPROVALS_REPLY_TO": "systemsteam@trypennie.com",
		// Snowflake archival mirror (milestone #15). Non-secret connection config;
		// the paired secret is SNOWFLAKE_PRIVATE_KEY (wrangler secret put). The
		// export lane is a safe no-op until the private key is set, so an empty
		// account here ships harmlessly. SNOWFLAKE_ACCOUNT is the account URL
		// prefix: the part before .snowflakecomputing.com. Slate's is the
		// orgname-accountname form below, NOT the locator-plus-region form this
		// comment used to give as an example (#1200). docs/snowflake-setup.md
		// step 4 derives it. The rest match docs/snowflake-setup.sql.
		"SNOWFLAKE_ACCOUNT": "vrkfjso-rwc54963",
		"SNOWFLAKE_USER": "SLATE_SERVICE",
		"SNOWFLAKE_DATABASE": "SLATE",
		"SNOWFLAKE_SCHEMA": "PUBLIC",
		"SNOWFLAKE_WAREHOUSE": "SLATE_WH",
		"SNOWFLAKE_ROLE": "SLATE_ROLE"
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets",
		// #1203 / #1204: a matching request is routed to THIS Worker before the
		// asset binding answers it. Without this, Cloudflare serves anything under
		// public/ without invoking the Worker at all, so `widget.js` (the script
		// partner pages load to embed the booker) was served over plain http with
		// none of the hardening headers every page and API route carries: the
		// #1024 redirect in worker/index.ts never ran, and neither did Next's
		// global headers(), which the routing layer applies to a worker-served
		// asset.
		//
		// Scoped to the ten files we actually ship in public/ rather than `true`:
		// worker-first on `/_next/*` would spend a Worker invocation on every
		// hashed, immutable build asset, which is always a subresource of an https
		// page we already redirect. scripts/test-asset-worker-first.ts pins both
		// halves (every public/ file covered, /_next/ still excluded).
		"run_worker_first": ["/widget.js", "/embed-example.html", "/brand/*"]
	},
	// Run the Worker near the data (Supabase us-west) since this app is DB-bound.
	"placement": {
		"mode": "smart"
	},
	"observability": {
		"enabled": true
	},
	// Edge rate limiter for /api/availability (#56): 30 requests/min per IP, per
	// datacenter, no DB round-trip. namespace_id is an arbitrary unique id (not a
	// created resource). period must be 10 or 60.
	"ratelimits": [
		{
			"name": "AVAIL_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 30, "period": 60 }
		},
		// Edge per-minute throttle for the public /booking confirm (#237): 3
		// requests/min per IP, per datacenter, no DB round-trip, so it no longer
		// adds latency to the lead's Confirm tap. The strict hourly cap (10/hour)
		// stays in the DB (the native binding can't express a 1-hour window).
		{
			"name": "BOOKING_RATE_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 3, "period": 60 }
		},
		// Edge per-minute burst window for the routing-preview lookup (#961): 20
		// requests/min per IP. The hourly cap (200/hour) stays in the DB.
		{
			"name": "ROUTING_RATE_LIMITER",
			"namespace_id": "1003",
			"simple": { "limit": 20, "period": 60 }
		},
		// Edge per-minute windows for the direct booking API (#961). Three separate
		// bindings because the native limiter fixes one limit per binding and these
		// are intentionally different sizes and keys; every hourly ceiling stays in
		// the DB. Write path, keyed per API key: 120/min.
		{
			"name": "BOOKINGAPI_RATE_LIMITER",
			"namespace_id": "1004",
			"simple": { "limit": 120, "period": 60 }
		},
		// Per-IP write backstop (#597), keyed per IP: 60/min. A block here is itself
		// a signal (the ceiling is too tight or a key leaked), alerted in code.
		{
			"name": "BOOKINGAPI_IP_RATE_LIMITER",
			"namespace_id": "1005",
			"simple": { "limit": 60, "period": 60 }
		},
		// Read path (lookup/list, #393), keyed per API key: 600/min, ~5x the write
		// window so status polling never starves the booking path.
		{
			"name": "BOOKINGAPI_READ_RATE_LIMITER",
			"namespace_id": "1006",
			"simple": { "limit": 600, "period": 60 }
		},
		// The customer's own manage link (#1046), keyed per IP: 20/min across cancel,
		// reschedule and the phone edit. Far above any real customer (moving one
		// appointment is a handful of requests); it exists so a garbage manage token
		// cannot buy unthrottled unauthenticated database round trips. Edge only, with
		// no hourly cap behind it, since the round trip is the thing being bounded.
		{
			"name": "MANAGE_RATE_LIMITER",
			"namespace_id": "1007",
			"simple": { "limit": 20, "period": 60 }
		}
	],
	// The second ceiling behind EVERY limiter above (#1536 for availability, #1556
	// for the rest). Each of those is enforced PER DATACENTER and counted
	// approximately, which bounds a sequential hammer and does not bound a
	// concurrent burst: measured against production on 2026-08-17, 45 sequential
	// requests were blocked at exactly 30 while 60 fired in parallel into one
	// datacenter were blocked zero times. A Durable Object is the only primitive
	// here that holds ONE count for a caller across isolates, so it is the
	// backstop behind the fast in-datacenter check rather than a replacement for
	// it. It is asked only about callers that have already crossed the escalation
	// threshold, so an ordinary booker load never reaches it.
	//
	// ONE namespace serves all six: the object id is derived from a key carrying
	// the endpoint as well as the caller, so no two endpoints share a count. Each
	// endpoint's own ceiling lives beside its sustained limit in EDGE_LIMITERS
	// (src/lib/rate-limit-core.ts) and is a large multiple of it, never equal:
	// a large office behind one NAT address is a real lead source, and this is a
	// flood backstop, not a tightening.
	"durable_objects": {
		"bindings": [
			{
				"name": "BURST_LIMITER",
				"class_name": "BurstLimiter"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["BurstLimiter"]
		}
	]
}
