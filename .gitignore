# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Cloudflare / OpenNext
.open-next/
.wrangler/

# >>> secret-bearing files
# Every pattern here ends in `*`, so a COPY of the file is ignored with it: a
# backup (.bak, .orig, ~, " copy") is the first thing anyone makes before
# editing one, and it carries the same secrets (#3650). Add a new secret file
# here, never in another section: scripts/test-repo-hygiene.ts reads this block
# and fails on a pattern without the trailing `*` or a copy git would track.
.env*
.dev.vars*
.cf-secrets.json*
*.pem*
*-key.json*
service-account*.json*
# ...but keep the committed placeholder template discoverable
!.env.example
# <<< secret-bearing files

# local browser-profile artifacts
/.playwright-mcp/

# browser-verification evidence (screenshots, axe JSON): local-only, never
# commit. Anchored so the tracked .claude/.../reports/ store is unaffected (#583).
/reports/

# Coverage output (#603)
coverage/

# The planted control file scripts/test-scripts-typecheck.ts writes and removes
# (#1516). It only ever survives a run that was killed part way through.
scripts/typecheck-control.tmp.ts

# The tree write tripwire's own probe (#2733). It only ever survives a run that
# was killed part way through, or one whose removal of it failed and said so.
.tree-write-tripwire-probe-*

# Browser check output: traces, the HTML report, the server log and the
# egress record (#3079, #3100). Local only; CI uploads it as an artifact.
/e2e/.artifacts/

