{
  "name": "slate",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "test": "pnpm test:node && pnpm test:components",
    "test:node": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/run-tests.ts",
    "test:components": "vitest run",
    "test:coverage": "node scripts/coverage.mjs",
    "cleanup:smoke-events": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/cleanup-smoke-events.ts",
    "cf:build": "opennextjs-cloudflare build && node --experimental-strip-types scripts/check-bundle-env.ts",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "pnpm cf:build && opennextjs-cloudflare deploy",
    "cf:deploy:verified": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/deploy-verified.ts",
    "cf:deploy:gradual": "node --experimental-strip-types scripts/deploy-gradual.ts",
    "cf:rollback": "node --experimental-strip-types scripts/rollback-production.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "build:machine-token-fixtures": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/build-machine-token-fixtures.ts",
    "build:confirmation-mark": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/build-confirmation-mark-assets.ts",
    "preview:booker": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/preview-booker.ts",
    "bundle:record": "NODE_NO_WARNINGS=1 node --experimental-strip-types scripts/bundle-budget.ts record",
    "hash:retired-key": "node --env-file-if-exists=.env.local --experimental-strip-types --import ./scripts/register-paths.mjs scripts/hash-retired-key.ts",
    "send:reminder-example": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/send-reminder-example.ts",
    "preview:alerts": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/preview-alerts.ts",
    "check:workflow-settings": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/check-workflow-settings.ts",
    "import:calcom-schedules": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/import-calcom-schedules.ts",
