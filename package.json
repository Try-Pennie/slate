    "measure:volume-floors": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/measure-volume-floors.ts",
    "check:db-dump": "node --experimental-strip-types scripts/check-db-dump.ts",
    "restore:from-snowflake": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/restore-from-snowflake.ts",
    "verify:kill-switch": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/verify-kill-switch-live.ts",
    "verify:burst-counter": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/verify-burst-counter-live.ts",
    "verify:refusal-alerts": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/verify-refusal-alerts-live.ts",
