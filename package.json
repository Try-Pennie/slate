    "verify:ooo-protection": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/verify-ooo-protection-live.ts",
    "verify:pool-entry": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/verify-pool-entry-live.ts",
    "verify:router-replay": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/verify-router-replay-live.ts",
    "verify:audit-chain-sql": "node --experimental-strip-types scripts/verify-audit-chain-sql.ts",
    "verify:advisor-photos-sql": "node --experimental-strip-types scripts/verify-advisor-photos-sql.ts",
    "verify:migration-replay-sql": "node --experimental-strip-types scripts/verify-migration-replay-sql.ts",
    "verify:advisor-photos": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/verify-advisor-photos-live.ts",
    "loadtest:export-shape": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/loadtest/export-roster-shape.ts",
    "test:e2e": "node --experimental-strip-types e2e/run.ts"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-react": "^0.20.0",
    "@lottiefiles/dotlottie-web": "0.81.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "googleapis": "^173.0.0",
    "libphonenumber-js": "^1.13.15",
    "luxon": "^3.7.2",
    "nanoid": "^6.0.2",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@opennextjs/cloudflare": "^1.20.12",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "3.2.6",
    "c8": "^12.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "jsdom": "^30.1.3",
    "pg": "^8.23.1",
    "playwright": "1.64.1",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^3.2.6",
    "wrangler": "^4.151.2"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.18": ">=8.5.18",
      "nanoid@<3.3.17": "^3.3.17",
      "proxy-addr@<2.0.8": "^2.0.8",
      "source-map-js@<1.2.2": "^1.2.2",
      "tinypool@<2.1.2": "^2.1.2",
      "sharp@<0.35.5": "^0.35.5"
    },
    "auditConfig": {
      "ignoreGhsas": []
    }
  }
}
