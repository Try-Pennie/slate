{
  "name": "slate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "test": "pnpm test:node && pnpm test:components",
    "test:node": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/run-tests.ts",
    "test:components": "vitest run",
    "test:coverage": "node scripts/coverage.mjs",
    "cleanup:smoke-events": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/cleanup-smoke-events.ts",
    "cf:build": "opennextjs-cloudflare build && node --experimental-strip-types scripts/check-bundle-env.ts",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:deploy:verified": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/deploy-verified.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "build:confirmation-mark": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/build-confirmation-mark-assets.ts",
    "preview:booker": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/preview-booker.ts",
    "bundle:record": "NODE_NO_WARNINGS=1 node --experimental-strip-types scripts/bundle-budget.ts record",
    "hash:retired-key": "node --env-file-if-exists=.env.local --experimental-strip-types --import ./scripts/register-paths.mjs scripts/hash-retired-key.ts",
    "send:reminder-example": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/send-reminder-example.ts",
    "preview:alerts": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/preview-alerts.ts",
    "check:workflow-settings": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/check-workflow-settings.ts",
    "import:calcom-schedules": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/import-calcom-schedules.ts",
    "backfill:bookable-trait": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/backfill-bookable-trait.ts",
    "report:pilot-split": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/report-pilot-split.ts",
    "report:pilot-compare": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/report-pilot-compare.ts",
    "verify:agent-link-names": "node --experimental-strip-types scripts/verify-agent-link-names-sql.ts",
    "verify:availability-truth": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/verify-availability-truth-live.ts",
    "verify:twilio-parity": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/verify-twilio-parity-live.ts",
    "verify:calcom-parity": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/verify-calcom-parity-live.ts",
    "verify:parallel-run-readiness": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/verify-parallel-run-readiness-live.ts",
    "verify:table-drift": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/verify-table-drift-live.ts",
    "verify:pool-slot-parity": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/verify-pool-slot-parity.ts",
    "measure:lead-hours": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/measure-lead-hours.ts",
    "measure:volume-floors": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/measure-volume-floors.ts",
    "verify:kill-switch": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/verify-kill-switch-live.ts",
    "verify:burst-counter": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/verify-burst-counter-live.ts",
    "verify:ooo-protection": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/verify-ooo-protection-live.ts",
    "verify:pool-entry": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/verify-pool-entry-live.ts",
    "verify:router-replay": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/verify-router-replay-live.ts",
    "verify:advisor-photos-sql": "node --experimental-strip-types scripts/verify-advisor-photos-sql.ts",
    "verify:advisor-photos": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/verify-advisor-photos-live.ts",
    "loadtest:export-shape": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/loadtest/export-roster-shape.ts"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-react": "^0.19.16",
    "@lottiefiles/dotlottie-web": "0.80.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "googleapis": "^173.0.0",
    "libphonenumber-js": "^1.13.14",
    "luxon": "^3.7.2",
    "nanoid": "^6.0.1",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/luxon": "^3.7.5",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "3.2.6",
    "c8": "^12.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "jsdom": "^30.1.1",
    "pg": "^8.23.0",
    "playwright": "1.63.0",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^3.2.6",
    "wrangler": "^4.142.0"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.18": ">=8.5.18",
      "nanoid@<3.3.17": "^3.3.17"
    },
    "auditConfig": {
      "ignoreGhsas": []
    }
  }
}
