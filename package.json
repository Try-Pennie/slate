{
  "name": "slate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "test": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/run-tests.ts && pnpm test:components",
    "test:components": "vitest run",
    "test:coverage": "node scripts/coverage.mjs",
    "cleanup:smoke-events": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/cleanup-smoke-events.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "prepare": "git config core.hooksPath .githooks || true",
    "preview:alerts": "node --experimental-strip-types --import ./scripts/register-paths.mjs scripts/preview-alerts.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "google-auth-library": "^10.9.1",
    "googleapis": "^173.0.0",
    "libphonenumber-js": "^1.13.10",
    "luxon": "^3.7.2",
    "nanoid": "^6.0.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/luxon": "^3.7.2",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "3.2.6",
    "c8": "^12.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "jsdom": "^29.1.1",
    "pg": "^8.22.0",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^3.2.6",
    "wrangler": "^4.115.0"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.18": ">=8.5.18"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-f88m-g3jw-g9cj",
        "GHSA-6g55-p6wh-862q"
      ]
    }
  }
}
