# --- App ---
# Public base URL of the Slate deployment (no trailing slash). Used for OAuth
# redirects, the embed SDK, manage links, and Google push webhook callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (new-style API keys: Dashboard -> Project Settings -> API Keys) ---
# WARNING (#3097): `pnpm dev` reads and WRITES whichever project these name, and
# there is no staging (docs/adr/0007-no-staging-environment.md). Production's URL
# and secret key here make every local write a production row. For local work use
# a separate Supabase project of your own with the whole migration set applied.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Client-safe publishable key (sb_publishable_…), replaces the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only secret key (sb_secret_…), bypasses RLS. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Google OAuth + Calendar ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Restrict SSO to the Pennie Workspace domain. Required: when it is unset every
# sign-in is refused (#3083). Allowing any Google account takes an explicit
# ALLOW_ANY_GOOGLE_DOMAIN=1 instead.
GOOGLE_HOSTED_DOMAIN=trypennie.com
# Same value, exposed to the login page to set Google's `hd` hint.
NEXT_PUBLIC_GOOGLE_HOSTED_DOMAIN=trypennie.com

# --- Google service account: domain-wide delegation (calendar access) ---
# REQUIRED: the service account Slate impersonates to read/write agent and OOO
# calendars (booking availability, OOO approval events). From the SA's JSON key.
GOOGLE_SA_CLIENT_EMAIL=slate-sa@YOUR-PROJECT.iam.gserviceaccount.com
# The private key from that JSON, with literal \n for newlines (one quoted line).
GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"

# --- Salesforce (agent roster sync; client-credentials External Client App) ---
SF_CLIENT_ID=your-sf-client-id
SF_CLIENT_SECRET=your-sf-client-secret
# No trailing slash.
SF_INSTANCE_URL=https://YOUR-ORG.my.salesforce.com

# --- Cron / push security ---
# Shared secret required on cron endpoints (the Cloudflare cron dispatcher sends
# it as a Bearer header).
CRON_SECRET=generate-a-long-random-string
# Token Slate sets on Google watch channels and verifies on incoming push pings.
GOOGLE_CHANNEL_TOKEN=generate-a-long-random-string

# --- Slack notifier (optional) ---
# WARNING (#3097): leave SLACK_BOT_TOKEN empty for local work. With a real token,
# every alert a local run raises posts to the real alerts channel.
# Bot token (xoxb-…) for a Slack app, installed to the workspace. Leave empty to
# make Slack notifications a no-op. Used for ops alerts (e.g. watch-channel
# lapses) and the OOO request/approval DMs + daily digest. Scopes: chat:write,
# users:read.email, im:write.
SLACK_BOT_TOKEN=
# Default channel id/name to post to (the bot must be a member).
SLACK_ALERTS_CHANNEL=
# Optional quieter channel for low-priority, visibility-only signals (e.g. a thin
# tier the tier-drop fallback is quietly covering, #567). The bot must be a member.
# Unset = these fall back to SLACK_ALERTS_CHANNEL so nothing is silently lost.
SLACK_INFO_CHANNEL=
# App signing secret — verifies inbound interaction requests for the in-Slack
# Approve/Decline buttons on OOO notifications (Slack app > Basic Information >
# Signing Secret). Empty = /api/slack/interactions rejects everything. Also set
# the app's Interactivity Request URL to <APP_URL>/api/slack/interactions.
SLACK_SIGNING_SECRET=

# --- Out of office (OOO) ---
# REQUIRED for the OOO tool: the Google calendar OOO approval events land on,
# and the default Workspace account the service account impersonates to write
# manager OOO calendars. Approval throws if this is unset.
MAIN_OOO_CAL_ID=ooo@trypennie.com
# Optional: a different impersonation actor for OOO calendar writes (defaults to
# MAIN_OOO_CAL_ID).
OOO_CALENDAR_ACTOR_EMAIL=
# #3027: the Google Workspace ADMIN account the advisor photo refresh reads the
# directory as (a wrangler.jsonc var in production).
DIRECTORY_ADMIN_SUBJECT=
# Daily OOO-approvals digest email (set as wrangler.jsonc vars). Comma-separated.
# Empty TO = the digest no-ops. Sent from the OOO actor mailbox; replies route to
# REPLY_TO.
OOO_APPROVALS_TO=
OOO_APPROVALS_BCC=
OOO_APPROVALS_REPLY_TO=
# Phased launch: leave unset/"false" so agents see only the OOO tool (no
# scheduling self-service). Set "true" to reveal availability to agents.
AGENT_SCHEDULING_LIVE=
# Cutover transition only: mirror approved OOO into Cal.com schedule overrides.
# Leave unset/"false" for the OOO-first launch. Requires CALCOM_* below.
OOO_CALCOM_DUAL_WRITE=
CALCOM_BASE_URL=
CALCOM_ORG_ID=
CALCOM_API_KEY=

# --- Twilio TaskRouter (required) ---
# Where managers actually tag agents, and what feeds cal.com's routing attributes.
# The hourly roster sync reads it for the Redistribute tag, which means the agent
# should not be taking booked calls and exists nowhere else (#2097). All three are
# required: any of them empty and the Twilio half refuses by name and pages, rather
# than quietly flipping nobody. The API key has to be TaskRouter scoped.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_WORKSPACE_SID=

# --- Misc (optional) ---
# Bearer key for POST /api/bookings/reassign (manual reassign API). Empty = disabled.
REASSIGN_API_KEY=
# Bearer key for POST /api/bookings/cancel-duplicate (#2369), called by Regal's
# double booking journeys. Its own key, not the reassign one: the journey that may
# cancel a call is not also handed the ability to move one. Empty = disabled (503).
DUPLICATE_CANCEL_API_KEY=
# Bearer key for the offboarding lifecycle API (POST /api/users/deactivate|reactivate),
# called by the offboarding automation. Empty = endpoints disabled (503).
OFFBOARDING_API_KEY=
# Low-volume booking alert (#370). Arm only once Slate owns roughly full traffic
# (unset = disarmed; counts are still logged each tick). Floors default 5 / 20.
BOOKING_VOLUME_ALERT_ARMED=
BOOKING_VOLUME_FLOOR_30=
BOOKING_VOLUME_FLOOR_120=
# Org-wide booking horizon fallback (#216): days ahead leads can book, 1 to 7.
# The admin settings screen overrides this; unset = the coded default (4).
SLATE_BOOKING_HORIZON_DAYS=
# Bearer key(s) for POST /api/bookings/direct (programmatic/AI booking API). Both
# empty = endpoint disabled (503). _2 is a second valid key for zero-downtime
# rotation. Self-generated secret (e.g. `openssl rand -base64 32`); share with the
# bot integrator. See docs/booking-api.md.
BOOKING_API_KEY=
BOOKING_API_KEY_2=
# One key per caller (#2645), each with a _2 rotation slot. BOOKING_API_KEY above is the shared pair.
# BOOKING_API_KEY_CANARY is also what the smoke and verify scripts send (#2822), so put it here
# to run them by hand; they never fall back to the shared key.
BOOKING_API_KEY_REGAL=
BOOKING_API_KEY_REGAL_2=
BOOKING_API_KEY_TRYPENNIE=
BOOKING_API_KEY_TRYPENNIE_2=
BOOKING_API_KEY_CANARY=
BOOKING_API_KEY_CANARY_2=
# Marcia's key (#2940) opens POST /api/bookings/cancel and nothing else.
BOOKING_API_KEY_MARCIA=
BOOKING_API_KEY_MARCIA_2=
# Bidspoke's key (#4388) opens POST /api/program-leads and nothing else. Named like the
# booking keys but in no booking caller key set. Empty = that route answers 503.
BOOKING_API_KEY_BIDSPOKE=
BOOKING_API_KEY_BIDSPOKE_2=
# The public test bucket (#2666). EMBED_TEST_ORIGINS is the comma list of exact
# origins allowed to open it (production's is a committed wrangler.jsonc var);
# EMBED_TEST_PASS_SECRET signs the short lived pass /book hands an approved page
# (`openssl rand -hex 32`). Either empty = the test path is OFF and /book says so.
# Leave both empty locally unless you are testing the test path itself.
EMBED_TEST_ORIGINS=
EMBED_TEST_PASS_SECRET=
# PROGRAM_LEAD_TOKEN_SECRET signs the short lived token the texted booking link hands a
# recognised program lead (#4389; `openssl rand -hex 32`). Empty = nobody is recognised
# as a program lead and everyone gets the ordinary booker.
PROGRAM_LEAD_TOKEN_SECRET=

# Fine-grained GitHub token (Actions read/write on Try-Pennie/slate) so the monitor
# cron lane can re-fire the smoke-canary workflow when GitHub drops a scheduled run
# (#525 follow-up). Empty = gap-filler is a no-op; GitHub's own schedule still runs
# the canary. See src/lib/monitor/canary-trigger.ts.
GITHUB_CANARY_TOKEN=

# Bearer key noodge sends on its /api/health and /api/health/availability checks
# (#1228), so each stamps its own uptime heartbeat and the lane watchdog pages when a
# check stops firing. The same value goes in noodge as SLATE_UPTIME_HEARTBEAT_KEY at
# `npm run monitors:sync:slate` time. Empty = the endpoints never stamp, so both
# heartbeats go stale and page; the health answers themselves are unaffected.
UPTIME_HEARTBEAT_KEY=

# --- Snowflake archival mirror (milestone #15, docs/snowflake-setup.md) ---
# The export lane authenticates to Snowflake with a key-pair JWT. While
# SNOWFLAKE_PRIVATE_KEY is unset the lane is a safe no-op (logs "not configured"
# and skips). PRIVATE_KEY is the only secret (wrangler secret put); the other six
# are non-sensitive and live in wrangler.jsonc vars in prod. Account = the URL
# prefix (locator plus region), e.g. ab12345.us-east-1.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
# RSA private key (PKCS#8 PEM). In .env.local write the newlines as literal \n on
# one line, like GOOGLE_SA_PRIVATE_KEY; the Worker un-escapes them on read.
SNOWFLAKE_PRIVATE_KEY=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=

# --- Tooling / CI only (NOT read by the app at runtime) ---
# Direct Postgres connection string for scripts/run-migration.mjs:
#   SLATE_DB_URL=postgres://...
# Used by the migration-drift CI job (repo secrets) and the local `supabase` CLI:
#   SUPABASE_ACCESS_TOKEN=...
#   SUPABASE_DB_PASSWORD=...

# --- Local development only ---
# Turns on /dev/preview?email=..., which acts as ANY user (admins included) with
# no sign-in, against the live database. Only honoured under `pnpm dev`, on a
# loopback host, with exactly 1 here (#3086). Leave it out unless you need it.
# SLATE_DEV_PREVIEW=1
